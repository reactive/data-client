{
  "name": "todo-app",
  "version": "0.2.24",
  "description": "todo-app - A reactive data client example",
  "scripts": {
    "lint": "yarn g:lint src --ext .ts,.tsx",
    "format": "run lint --fix",
    "test:type": "tsc",
    "start": "webpack serve --mode=development",
    "start:prod": "yarn dlx serve dist",
    "build:browser": "webpack --mode=production",
    "build:analyze": "webpack --mode=production --env analyze",
    "build:profile": "webpack --mode=production --env profile",
    "test:pkg": "webpack --env check=nobuild"
  },
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "stackblitz": {
    "startCommand": "npm start"
  },
  "browserslist": "extends @anansi/browserslist-config",
  "keywords": [
    "anansi"
  ],
  "main": "src/index.ts",
  "types": "src/index.ts",
  "private": true,
  "license": "Apache-2.0",
  "devDependencies": {
    "@anansi/babel-preset": "7.0.1",
    "@anansi/browserslist-config": "1.7.7",
    "@anansi/webpack-config": "22.0.1",
    "@babel/core": "8.0.7",
    "@linaria/core": "8.2.0",
    "@linaria/react": "8.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/uuid": "^11.0.0",
    "react-refresh": "0.19.0",
    "webpack": "5.112.0",
    "webpack-cli": "7.2.3",
    "webpack-dev-server": "6.0.0"
  },
  "dependencies": {
    "@babel/runtime-corejs3": "^8.0.0",
    "@data-client/endpoint": "0.18.2",
    "@data-client/react": "0.18.2",
    "@data-client/rest": "0.18.2",
    "core-js": "^3.40.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "uuid": "^14.0.0"
  },
  "overrides": {
    "serialize-javascript": ">=7.0.5",
    "sockjs": {
      "uuid": ">=11.1.1"
    },
    "qs": ">=6.16.0",
    "happy-dom": "^21.0.4"
  }
}
