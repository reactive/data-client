{
  "name": "example-benchmark",
  "version": "0.4.87",
  "description": "Benchmark for normalizr",
  "main": "index.js",
  "author": "Nathaniel Tucker",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.18.0 || >=24.11.0"
  },
  "scripts": {
    "build": "webpack --mode=production --target=node --env readable",
    "start": "NODE_ENV=production node --allow-natives-syntax ./index.js",
    "start:memory": "NODE_ENV=production node ./memory.js",
    "start:trace": "yarn run start --trace_opt --trace_deopt",
    "start:deopt": "NODE_ENV=production npx dexnode --out v8.log --redirect-code-traces-to=/tmp/codetrace --allow-natives-syntax ./index.js"
  },
  "dependencies": {
    "@data-client/core": "workspace:*",
    "@data-client/endpoint": "workspace:*",
    "@data-client/normalizr": "workspace:*",
    "benchmark": "2.1.4",
    "normalizr": "3.6.2",
    "react": "19.3.1"
  },
  "devDependencies": {
    "@anansi/webpack-config": "22.0.0",
    "@babel/core": "8.0.7",
    "@babel/node": "8.0.6",
    "@types/benchmark": "2.1.5",
    "@types/react": "19.3.0",
    "webpack": "5.111.1",
    "webpack-cli": "7.2.3"
  }
}
