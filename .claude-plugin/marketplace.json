{
  "name": "data-client",
  "owner": {
    "name": "Nathaniel Tucker",
    "email": "me@ntucker.me"
  },
  "metadata": {
    "description": "Agent skills for Reactive Data Client, matched to the version your project installs"
  },
  "plugins": [
    {
      "name": "data-client",
      "description": "Sets up Data Client, then points your agent at the skills shipped in your installed @data-client packages, so React or Vue apps get the guidance for their version",
      "source": "./",
      "strict": false,
      "homepage": "https://dataclient.io/docs/getting-started/agent-skills",
      "license": "Apache-2.0",
      "skills": [
        "./.agents/skills/data-client",
        "./.agents/skills/data-client-setup"
      ],
      "hooks": {
        "SessionStart": [
          {
            "hooks": [
              {
                "type": "command",
                "command": "command -v node >/dev/null && node \"${CLAUDE_PLUGIN_ROOT}/.claude-plugin/session-start.mjs\" || true"
              }
            ]
          }
        ]
      }
    },
