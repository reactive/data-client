@@ -0,0 +1,99 @@
+import { Collection, resource } from '@data-client/rest';
+
+import { ApiEndpoint } from '@/lib/api-client';
+import type { Meta } from '@/types/api';
+
+import { Comment, Discussion, Team, User } from './entities';
+
+export { Comment, Discussion, Team, User } from './entities';
+
+export const TeamResource = resource({
+  path: '/teams/:id',
+  schema: Team,
+  Endpoint: ApiEndpoint,
+}).extend((Base) => ({
+  getList: Base.getList.extend({ schema: { data: [Team] } }),
+}));
+
+export const UserResource = resource({
+  path: '/users/:id',
+  schema: User,
+  Endpoint: ApiEndpoint,
+}).extend((Base) => ({
+  getList: Base.getList.extend({ schema: { data: [User] } }),
+  // the API updates the signed-in user at a path without an id
+  updateProfile: new ApiEndpoint({
+    path: '/users/profile',
+    method: 'PATCH',
+    body: {} as {
+      email: string;
+      firstName: string;
+      lastName: string;
+      bio: string;
+    },
+    schema: User,
+    getOptimisticResponse(snap, body) {
+      const session = snap.getResponse(getUser);
+      const current = session.data?.data;
+      if (!current) throw snap.abort;
+      return { ...current, ...body };
+    },
+  }),
+}));
+
+export const DiscussionResource = resource({
+  path: '/discussions/:id',
+  searchParams: {} as { page?: number },
+  schema: Discussion,
+  Endpoint: ApiEndpoint,
+  optimistic: true,
+}).extend((Base) => ({
+  get: Base.get.extend({ schema: { data: Discussion } }),
+  getList: Base.getList.extend({
+    schema: { data: [Discussion], meta: {} as Meta },
+  }),
+}));
+
+// a new discussion shifts every numbered page, so this POST joins no list: callers expire the list
+export const createDiscussion = new ApiEndpoint({
+  path: '/discussions',
+  method: 'POST',
+  body: {} as { title: string; body: string },
+  schema: Discussion,
+});
+
+/** Every page of one discussion's comments shares one list */
+const discussionComments = new Collection([Comment], {
+  argsKey: ({ discussionId }: { discussionId?: string }) => ({ discussionId }),
+});
+
+export const CommentResource = resource({
+  path: '/comments/:id',
+  searchParams: {} as { discussionId?: string; page?: number },
+  schema: Comment,
+  Endpoint: ApiEndpoint,
+  optimistic: true,
+}).extend((Base) => ({
+  getList: Base.getList.extend({
+    schema: { data: discussionComments, meta: {} as Meta },
+    paginationField: 'page',
+  }),
+}));
+
+/** Joins the discussion's list, shown at once with the signed-in user as author */
+export const createComment = new ApiEndpoint({
+  path: '/comments',
+  method: 'POST',
+  body: {} as { discussionId: string; body: string },
+  schema: discussionComments.push,
+  getOptimisticResponse(snap, body) {
+    const author = snap.getResponse(getUser).data?.data;
+    return { ...body, author };
+  },
+});
+
+/** The signed-in user. The API answers `{}` when nobody is signed in. */
+export const getUser = new ApiEndpoint({
+  path: '/auth/me',
+  schema: { data: User },
+});
