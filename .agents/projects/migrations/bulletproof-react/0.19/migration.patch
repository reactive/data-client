diff --git a/apps/react-vite/src/hooks/use-mutate.ts b/apps/react-vite/src/hooks/use-mutate.ts
new file mode 100644
index 0000000..dc63179
--- /dev/null
+++ b/apps/react-vite/src/hooks/use-mutate.ts
@@ -0,0 +1,16 @@
+import { useLoading } from '@data-client/react';
+import { useState } from 'react';
+
+/** Runs a mutation and tracks `isPending`, `error` and `isDone`. */
+export function useMutate<A extends unknown[]>(
+  mutate: (...args: A) => Promise<unknown>,
+  deps: readonly unknown[],
+) {
+  const [isDone, setIsDone] = useState(false);
+  const [run, isPending, error] = useLoading(async (...args: A) => {
+    setIsDone(false);
+    await mutate(...args);
+    setIsDone(true);
+  }, deps);
+  return { run, isPending, error, isDone };
+}
