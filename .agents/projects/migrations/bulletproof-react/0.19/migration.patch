@@ -0,0 +1,72 @@
+import { Entity } from '@data-client/rest';
+
+export class User extends Entity {
+  id = '';
+  createdAt = 0;
+  firstName = '';
+  lastName = '';
+  email = '';
+  role: 'ADMIN' | 'USER' = 'USER';
+  teamId = '';
+  bio = '';
+
+  static key = 'User';
+}
+
+export class Team extends Entity {
+  id = '';
+  createdAt = 0;
+  name = '';
+  description = '';
+
+  static key = 'Team';
+}
+
+/** The API sends `author: {}` when the author no longer exists. */
+function emptyAuthorToUndefined(processed: any) {
+  const { author } = processed;
+  if (author && typeof author === 'object' && !Object.keys(author).length)
+    processed.author = undefined;
+  return processed;
+}
+
+export class Discussion extends Entity {
+  id = '';
+  createdAt = 0;
+  title = '';
+  body = '';
+  teamId = '';
+  author?: User = undefined;
+
+  static schema = { author: User };
+  static key = 'Discussion';
+
+  static process(
+    input: any,
+    parent: any,
+    key: string | undefined,
+    args: any[],
+  ) {
+    return emptyAuthorToUndefined(super.process(input, parent, key, args));
+  }
+}
+
+export class Comment extends Entity {
+  id = '';
+  createdAt = 0;
+  body = '';
+  discussionId = '';
+  author?: User = undefined;
+
+  static schema = { author: User };
+  static key = 'Comment';
+
+  static process(
+    input: any,
+    parent: any,
+    key: string | undefined,
+    args: any[],
+  ) {
+    return emptyAuthorToUndefined(super.process(input, parent, key, args));
+  }
+}
