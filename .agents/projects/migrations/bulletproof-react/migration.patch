@@ -0,0 +1,58 @@
+import { Entity, resource } from '@data-client/rest';
+import { z } from 'zod';
+
+import { ApiEndpoint } from '@/lib/api-client';
+import { Meta } from '@/types/api';
+
+import { User } from '../../users/api/user';
+
+export class Discussion extends Entity {
+  id = '';
+  createdAt = 0;
+  title = '';
+  body = '';
+  teamId = '';
+  author: User | undefined = undefined;
+
+  static key = 'Discussion';
+  static schema = { author: User };
+
+  // the API sends `author: {}` when the author no longer exists
+  static process(input: any, ...args: any[]) {
+    const { author, ...rest } = input;
+    return author?.id ? input : rest;
+  }
+}
+
+export const discussionInputSchema = z.object({
+  title: z.string().min(1, 'Required'),
+  body: z.string().min(1, 'Required'),
+});
+
+export type DiscussionInput = z.infer<typeof discussionInputSchema>;
+
+export const DiscussionResource = resource({
+  path: '/discussions/:id',
+  schema: Discussion,
+  Endpoint: ApiEndpoint,
+  searchParams: {} as { page?: number },
+  body: {} as DiscussionInput,
+}).extend((Base) => ({
+  partialUpdate: Base.partialUpdate.extend({
+    getOptimisticResponse(snap, { id }, body) {
+      const discussion = snap.get(Discussion, { id });
+      if (!discussion) throw snap.abort;
+      return { ...discussion, ...body };
+    },
+  }),
+  get: Base.get.extend({ schema: { data: Discussion } }),
+  getList: Base.getList.extend({
+    schema: { data: [Discussion], meta: {} as Meta },
+  }),
+  create: new ApiEndpoint({
+    path: '/discussions',
+    method: 'POST',
+    body: {} as DiscussionInput,
+    schema: Discussion,
+  }),
+}));
