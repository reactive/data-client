diff --git a/apps/react-vite/src/hooks/use-mutate.ts b/apps/react-vite/src/hooks/use-mutate.ts
new file mode 100644
index 0000000..1b7473c
--- /dev/null
+++ b/apps/react-vite/src/hooks/use-mutate.ts
@@ -0,0 +1,16 @@
+import { useLoading } from '@data-client/react';
+import { useState } from 'react';
+
+/** useLoading() plus whether the last call succeeded, so dialogs can close */
+export const useMutate = <A extends unknown[]>(
+  mutate: (...args: A) => Promise<unknown>,
+  deps: readonly unknown[],
+) => {
+  const [isDone, setIsDone] = useState(false);
+  const [run, isPending] = useLoading(async (...args: A) => {
+    setIsDone(false);
+    await mutate(...args);
+    setIsDone(true);
+  }, deps);
+  return { run, isPending, isDone };
+};
