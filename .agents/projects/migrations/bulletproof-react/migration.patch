+import { Entity, schema } from '@data-client/rest';
+import { z } from 'zod';
+
+import { ApiEndpoint } from '@/lib/api-client';
+
+export class User extends Entity {
+  id = '';
+  createdAt = 0;
+  firstName = '';
+  lastName = '';
+  email = '';
+  role: 'ADMIN' | 'USER' = 'USER';
+  teamId = '';
+  bio = '';
+
+  static key = 'User';
+}
+
+export const getUser = new ApiEndpoint({
+  path: '/auth/me',
+  schema: { data: User },
+});
+
+export const getUsers = new ApiEndpoint({
+  path: '/users',
+  schema: { data: [User] },
+});
+
+export const deleteUser = new ApiEndpoint({
+  path: '/users/:id',
+  method: 'DELETE',
+  schema: new schema.Invalidate(User),
+});
+
+export const updateProfileInputSchema = z.object({
+  email: z.string().min(1, 'Required').email('Invalid email'),
+  firstName: z.string().min(1, 'Required'),
+  lastName: z.string().min(1, 'Required'),
+  bio: z.string(),
+});
+
+export type UpdateProfileInput = z.infer<typeof updateProfileInputSchema>;
+
+export const updateProfile = new ApiEndpoint({
+  path: '/users/profile',
+  method: 'PATCH',
+  body: {} as UpdateProfileInput,
+  schema: User,
+  getOptimisticResponse(snap, body) {
+    const user = snap.getResponse(getUser).data?.data;
+    if (!user) throw snap.abort;
+    return { ...user, ...body };
+  },
+});
