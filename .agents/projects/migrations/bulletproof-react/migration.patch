diff --git a/apps/react-vite/src/features/comments/api/comment.ts b/apps/react-vite/src/features/comments/api/comment.ts
new file mode 100644
index 0000000..1f63411
--- /dev/null
+++ b/apps/react-vite/src/features/comments/api/comment.ts
@@ -0,0 +1,71 @@
+import { Collection, Entity, schema } from '@data-client/rest';
+import { z } from 'zod';
+
+import { ApiEndpoint } from '@/lib/api-client';
+import { Meta } from '@/types/api';
+
+import { User, getUser } from '../../users/api/user';
+
+export class Comment extends Entity {
+  id = '';
+  createdAt = 0;
+  body = '';
+  discussionId = '';
+  author: User | undefined = undefined;
+
+  static key = 'Comment';
+  static schema = { author: User };
+
+  // the API sends `author: {}` when the author no longer exists
+  static process(input: any, ...args: any[]) {
+    const { author, ...rest } = input;
+    return author?.id ? input : rest;
+  }
+}
+
+// every page of a discussion's comments goes in the same list
+const commentsOf = new Collection([Comment], {
+  argsKey: ({ discussionId }: { discussionId: string }) => ({ discussionId }),
+});
+
+export const getComments = new ApiEndpoint({
+  path: '/comments',
+  searchParams: {} as { discussionId: string; page?: number },
+  schema: { data: commentsOf, meta: {} as Meta },
+  paginationField: 'page',
+});
+
+export const createCommentInputSchema = z.object({
+  discussionId: z.string().min(1, 'Required'),
+  body: z.string().min(1, 'Required'),
+});
+
+export type CreateCommentInput = z.infer<typeof createCommentInputSchema>;
+
+export const createComment = new ApiEndpoint({
+  path: '/comments',
+  method: 'POST',
+  searchParams: {} as { discussionId: string },
+  body: {} as CreateCommentInput,
+  schema: commentsOf.push,
+  getOptimisticResponse(snap, { discussionId }, body) {
+    const author = snap.getResponse(getUser).data?.data;
+    if (!author) throw snap.abort;
+    return {
+      id: `optimistic-${Date.now()}`,
+      createdAt: Date.now(),
+      ...body,
+      discussionId,
+      author,
+    };
+  },
+});
+
+export const deleteComment = new ApiEndpoint({
+  path: '/comments/:id',
+  method: 'DELETE',
+  schema: new schema.Invalidate(Comment),
+  getOptimisticResponse(snap, { id }) {
+    return { id };
+  },
+});
