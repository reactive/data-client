diff --git a/apps/react-vite/e2e/tests/optimistic.spec.ts b/apps/react-vite/e2e/tests/optimistic.spec.ts
new file mode 100644
index 0000000..25a26e4
--- /dev/null
+++ b/apps/react-vite/e2e/tests/optimistic.spec.ts
@@ -0,0 +1,58 @@
+import { test, expect } from '@playwright/test';
+
+import {
+  createComment,
+  createDiscussion,
+} from '../../src/testing/data-generators';
+
+// the mock API takes at least 300ms to answer, so anything shown sooner is optimistic
+const FASTER_THAN_NETWORK = { timeout: 250 };
+
+test('discussion and comment mutations show before the server answers', async ({
+  page,
+}) => {
+  const discussion = createDiscussion();
+  const comment = createComment();
+
+  await page.goto('/app/discussions');
+  await page.getByRole('button', { name: 'Create Discussion' }).click();
+  await page.getByLabel('Title').fill(discussion.title);
+  await page.getByLabel('Body').fill(discussion.body);
+  await page.getByRole('button', { name: 'Submit' }).click();
+  await page
+    .getByLabel('Discussion Created')
+    .getByRole('button', { name: 'Close' })
+    .click();
+  await page
+    .getByRole('row', { name: new RegExp(discussion.title) })
+    .getByRole('link', { name: 'View' })
+    .click();
+
+  // update discussion
+  await page.getByRole('button', { name: 'Update Discussion' }).click();
+  await page.getByLabel('Title').fill(`${discussion.title} - updated`);
+  await page.getByRole('button', { name: 'Submit' }).click();
+  // not getByRole: the open drawer hides the page behind it from the accessibility tree
+  await expect(
+    page.locator('h1', { hasText: `${discussion.title} - updated` }),
+  ).toBeVisible(FASTER_THAN_NETWORK);
+  await page
+    .getByLabel('Discussion Updated')
+    .getByRole('button', { name: 'Close' })
+    .click();
+
+  // create comment
+  await page.getByRole('button', { name: 'Create Comment' }).click();
+  await page.getByLabel('Body').fill(comment.body);
+  await page.getByRole('button', { name: 'Submit' }).click();
+  await expect(page.getByText(comment.body)).toBeVisible(FASTER_THAN_NETWORK);
+  await page
+    .getByLabel('Comment Created')
+    .getByRole('button', { name: 'Close' })
+    .click();
+
+  // delete comment
+  await page.getByRole('button', { name: 'Delete Comment' }).click();
+  await page.getByRole('button', { name: 'Delete Comment' }).click();
+  await expect(page.getByText(comment.body)).toBeHidden(FASTER_THAN_NETWORK);
+});
diff --git a/apps/react-vite/e2e/tests/stale-list.spec.ts b/apps/react-vite/e2e/tests/stale-list.spec.ts
new file mode 100644
index 0000000..25490ea
--- /dev/null
+++ b/apps/react-vite/e2e/tests/stale-list.spec.ts
@@ -0,0 +1,38 @@
+import { test, expect } from '@playwright/test';
+
+import { createDiscussion } from '../../src/testing/data-generators';
+
+// an updated discussion must show its new title in the list when navigating back to it
+test('discussions list reflects an update made on the discussion page', async ({
+  page,
+}) => {
+  const discussion = createDiscussion();
+  const updatedTitle = `${discussion.title} - updated`;
+
+  await page.goto('/app/discussions');
+  await page.getByRole('button', { name: 'Create Discussion' }).click();
+  await page.getByLabel('Title').fill(discussion.title);
+  await page.getByLabel('Body').fill(discussion.body);
+  await page.getByRole('button', { name: 'Submit' }).click();
+  await page
+    .getByLabel('Discussion Created')
+    .getByRole('button', { name: 'Close' })
+    .click();
+  await expect(page.getByText(discussion.title)).toBeVisible();
+
+  await page
+    .getByRole('row', { name: new RegExp(discussion.title) })
+    .getByRole('link', { name: 'View' })
+    .click();
+  await page.getByRole('button', { name: 'Update Discussion' }).click();
+  await page.getByLabel('Title').fill(updatedTitle);
+  await page.getByRole('button', { name: 'Submit' }).click();
+  await expect(page.getByRole('heading', { name: updatedTitle })).toBeVisible();
+
+  // client-side navigation, so cached list data is what renders first
+  await page.getByRole('link', { name: 'Discussions' }).click();
+  await page.waitForURL('/app/discussions');
+  await expect(
+    page.getByRole('row', { name: new RegExp(updatedTitle) }),
+  ).toBeVisible();
+});
